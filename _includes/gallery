{%- comment -%}
Galleria fotografica auto-popolata con lightbox (GLightbox).

Convenzione: la cartella passata in `path` contiene due sottocartelle:
  thumb/  immagini ridotte (mostrate in griglia)
  edit/   immagini complete (aperte nel lightbox), STESSI nomi file di thumb/

Si possono mettere piu include su una stessa pagina con `path` diversi:
ogni griglia ha un `data-gallery` distinto (derivato dal path).

Parametri:
  path     (obbligatorio) percorso della cartella evento, es. lazzaro/img/foo/
  class    (opzionale)    classi extra sul contenitore .gallery
{%- endcomment -%}

{%- comment -%}
Le immagini delle pagine vivono dentro le COLLEZIONI (es. _lazzaro/img/...): Jekyll
NON le espone in site.static_files ma in site.collections[].files, con path tipo
"_lazzaro/img/.../thumb/x.jpg" (underscore iniziale, niente url). Quindi si scorrono
le collezioni e si ricostruisce l'URL servito togliendo l'underscore di testa.
Guardia: senza path non si raccoglie nulla (eviterebbe foto miste tra eventi).
{%- endcomment -%}
{%- assign imgs = "" | split: "" -%}
{%- if include.path and include.path != "" -%}
  {%- assign thumb_path = include.path | append: "thumb/" -%}
  {%- comment -%} Le immagini possono stare in due posti, a seconda di dove vive la pagina:
    - COLLEZIONI (es. _lazzaro/img/...), pagine dei submodule: site.collections[].files
    - FILE STATICI del sito (es. /images/posts/...), i post: site.static_files
    Si scorrono ENTRAMBI; il path servito si normalizza piu sotto (vale per tutti e due). {%- endcomment -%}
  {%- for coll in site.collections -%}
    {%- assign hits = coll.files | where_exp: "f", "f.path contains thumb_path" -%}
    {%- assign imgs = imgs | concat: hits -%}
  {%- endfor -%}
  {%- assign static_hits = site.static_files | where_exp: "f", "f.path contains thumb_path" -%}
  {%- assign imgs = imgs | concat: static_hits -%}
  {%- assign imgs = imgs | sort: "path" -%}
{%- endif -%}
{%- assign gallery_id = include.path | slugify -%}

{%- comment -%} CSS e JS di GLightbox servono UNA volta sola per pagina, anche con piu
  include gallery: la guardia `gallery_assets_emitted` sfrutta il fatto che gli assign
  di un include in Jekyll restano visibili negli include successivi della stessa pagina.
  Il flag viene messo a true solo in fondo, cosi sia questo blocco CSS sia quello JS in
  coda scattano entrambi al primo include e vengono saltati da quelli dopo. {%- endcomment -%}
{%- unless gallery_assets_emitted -%}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox/dist/css/glightbox.min.css">

<style>
.gallery { display:grid; grid-template-columns:repeat(auto-fill,minmax(180px,1fr)); gap:0.25rem; margin:1rem 0; }
.gallery a { display:block; aspect-ratio:1; overflow:hidden; }
.gallery img { width:100%; height:100%; object-fit:cover; display:block; transition:transform .3s ease; }
.gallery a:hover img { transform:scale(1.04); }
</style>
{%- endunless -%}

<div class="gallery {{ include.class }}">
  {%- for img in imgs -%}
    {%- assign ext = img.extname | downcase -%}
    {%- if ext == ".jpg" or ext == ".jpeg" or ext == ".webp" or ext == ".png" -%}
      {%- comment -%} Normalizza il path servito da entrambe le sorgenti:
        collezione "_lazzaro/img/.../x.jpg" -> "/lazzaro/img/.../x.jpg"
        statico    "/images/posts/.../x.jpg" -> "/images/posts/.../x.jpg"
        prepend "/" uniforma, replace_first "//"->"/" sgonfia il doppio slash degli
        statici, replace_first "/_"->"/" toglie l'underscore delle collezioni. {%- endcomment -%}
      {%- assign thumb_url = img.path | prepend: "/" | replace_first: "//", "/" | replace_first: "/_", "/" -%}
      {%- assign full_url = thumb_url | replace: "/thumb/", "/edit/" -%}
      <a href="{{ full_url | relative_url }}" class="glightbox" data-gallery="{{ gallery_id }}">
        <img src="{{ thumb_url | relative_url }}" alt="{{ img.name }}" loading="lazy" decoding="async">
      </a>
    {%- endif -%}
  {%- endfor -%}
</div>

{%- unless gallery_assets_emitted -%}
<script src="https://cdn.jsdelivr.net/npm/glightbox/dist/js/glightbox.min.js"></script>
<script>
  (function () {
    if (!window.__glightboxInit) {
      window.__glightboxInit = true;
      // Inizializza dopo il parsing completo: cosi raccoglie TUTTE le griglie
      // anche quando ci sono piu include gallery nella stessa pagina.
      var init = function () { GLightbox({ selector: '.glightbox', loop: true, touchNavigation: true }); };
      if (document.readyState !== 'loading') { init(); }
      else { document.addEventListener('DOMContentLoaded', init); }
    }
    // Il main.min.js del tema aggiunge data-lity a OGNI link immagine (al ready di
    // jQuery), aprendo una seconda lightbox (Lity) sopra GLightbox. Lo togliamo dai
    // link della griglia DOPO il load, quando quel tagging e gia avvenuto.
    var strip = function () {
      var links = document.querySelectorAll('.gallery a.glightbox[data-lity]');
      for (var i = 0; i < links.length; i++) { links[i].removeAttribute('data-lity'); }
    };
    if (document.readyState === 'complete') { strip(); }
    else { window.addEventListener('load', strip); }
  })();
</script>
{%- assign gallery_assets_emitted = true -%}
{%- endunless -%}
